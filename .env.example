# Copy to .env — both `npm run dev` and `npm start` read it.
# The key stays in Node; the browser receives only a session ID and SDP answer.
OPENAI_API_KEY=sk-...

# Voice options: ripple, vesper, stone, meridian, tempo, beacon, cinder.
# OPENAI_VOICE=ripple

# Preselected in the model picker when the key can reach it.
# OPENAI_LIVE_MODEL=gpt-live-1

# Responses backend for reasoning and tools.
# OPENAI_BACKEND_MODEL=gpt-5.6-terra

# Hosted web search; each browser can also turn it off in tools.
# WEB_SEARCH=true

# Point the proxy at a gateway or a stub instead of OpenAI.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Memory: the remember/forget tools, and the memory block in the prompt. The
# list itself lives in the browser — set this to false to switch the whole
# feature off for everyone the server serves.
# MEMORY=true

# Coding agents Vince may hand work to. Off unless this names one: a connector
# runs a CLI that edits real files, so it is opt-in on the machine that would be
# edited. Known: codex. Everything below can also be set from the connectors
# panel, which writes connectors.json and survives a restart.
# CONNECTORS=codex

# Where the agent works, and the limits on it.
# CONNECTOR_CWD=/path/to/the/repo
# CONNECTOR_TIMEOUT=900        # seconds before a task is stopped
# CONNECTOR_LIMIT=3            # how many may run at once
# CONNECTOR_FILE=connectors.json
# CONNECTOR_ANNOUNCE=true      # tell Vince when a task finishes

# Per agent. The command line is deliberately not editable from the browser —
# that is choosing which binary this server executes, not configuring a tool.
# CODEX_COMMAND=codex
# CODEX_MODEL=
# CODEX_SANDBOX=workspace-write
# CODEX_ARGS=
# CODEX_CWD=

# PORT=5173
